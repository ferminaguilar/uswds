<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect direct visits from /uswds/web/... to /uswds/...
  RewriteCond %{THE_REQUEST} /uswds/web/([^\s\?]*) [NC]
  RewriteRule ^web/(.*)$ /uswds/$1 [R=301,L]

  # Direct visit to /uswds/web or /uswds/web/
  RewriteCond %{THE_REQUEST} /uswds/web[\s\?] [NC]
  RewriteRule ^web/?$ /uswds/ [R=301,L]

  # Internally route all requests to the web directory
  RewriteCond %{REQUEST_URI} !^/uswds/web/
  RewriteRule ^(.*)$ web/$1 [L,QSA]
</IfModule>
